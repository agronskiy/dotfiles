{
    "name": "Vimium C",
    "keyMappings": [
        "map H previousTab",
        "map L nextTab",
        "map <c-h> previousTab",
        "map <c-l> nextTab",
        "map tt createTab",
        "map xx removeTab",
        "map dd removeTab",
        "map ZZ removeTab",
        "map ZQ removeTab",
        "map u restoreTab",
        "map <c-o> goBack",
        "map <c-i> goForward",
        "map gh goToRoot",
        "map <c-d> scrollPageDown",
        "map <c-u> scrollPageUp",
        "map <c-f> scrollFullPageDown",
        "map <c-b> scrollFullPageUp",
        "map 0 scrollToLeft",
        "map $ scrollToRight",
        "map <enter> LinkHints.activate",
        "map gx LinkHints.activateOpenInNewTab",
        "map * findSelected",
        "map # findSelectedBackwards",
        "map ' Marks.activate",
        "map : Vomnibar.activate",
        "map ; Vomnibar.activate",
        "map <space>ff Vomnibar.activate",
        "map <space>fF Vomnibar.activateInNewTab",
        "map <space>fj Vomnibar.activateTabs",
        "map <space>fh Vomnibar.activateHistory",
        "map <space>fb Vomnibar.activateBookmarks",
        "map <space>fs enterFindMode",
        "map <space>c removeTab",
        "map <space>bo closeOtherTabs",
        "map <space>Z closeOtherTabs",
        "map <space>vs moveTabToNewWindow",
        "map <space>yf copyCurrentUrl",
        "map <space>yr copyCurrentTitle",
        "map s sendToExtension id=jbjllgdmphchokkcjjefbjkcebfnpcme data=pounce",
        "mapKey <c-j:i> <esc>",
        "mapKey <c-j:o> <down>",
        "mapKey <c-k:o> <up>",
        "mapKey <c-n:o> <down>",
        "mapKey <c-p:o> <up>",
        ""
    ]
}
