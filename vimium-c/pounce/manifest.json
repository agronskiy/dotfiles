{
    "manifest_version": 3,
    "name": "Pounce",
    "version": "0.1.0",
    "description": "Fuzzy jump to visible text and select it, pounce.nvim style",
    "key": "",
    "background": {
        "service_worker": "background.js"
    },
    "permissions": ["webNavigation"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle",
            "all_frames": true,
            "match_about_blank": true,
            "match_origin_as_fallback": true
        }
    ],
    "commands": {
        "pounce": {
            "suggested_key": { "default": "Alt+Period" },
            "description": "Pounce"
        }
    }
}
